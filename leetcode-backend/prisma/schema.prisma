// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  FACULTY
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ProblemType {
  PRACTICE
  PRACTICAL
  EXAM
}

enum ExecutionMode {
  JUDGE0_RUN
  JUDGE0_GRADE
  WEB_RENDER
}

model Subject {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  units     Unit[]
  offerings CourseOffering[]
}

model Unit {
  id        String   @id @default(uuid())
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title     String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  problems  Problem[]
}

model User {
  id        String   @id @default(uuid())
  name      String?
  email     String   @unique
  image     String?
  role      UserRole @default(USER)
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Students only — null for FACULTY and ADMIN, who sign in by email.
  enrollmentNo String? @unique

  /// Set on admin-created accounts; blocks all other routes until cleared.
  mustChangePassword Boolean @default(false)

  /// True only for accounts the institution created (seed, admin, CSV import).
  /// Bulk enrollment matches on enrollment number alone, so without this flag a
  /// stranger could self-register an unclaimed number and be swept into that
  /// section along with the real students.
  provisionedByAdmin Boolean @default(false)

  problems      Problem[]
  submissions   Submission[]
  problemSolved ProblemSolved[]
  playlists     Playlist[]
  codeSessions  CodeSession[]
  batches       BatchMember[]
  offerings         CourseOffering[] @relation("FacultyOfferings")
  offeringsAssigned CourseOffering[] @relation("OfferingsAssignedBy")
  notifications     Notification[]
}

/// A section of students, e.g. "A" = IU234123 + serials 0001..0132. The range
/// is only used to bulk-resolve members; membership itself lives in
/// BatchMember so transfers and exceptions stay editable.
model Batch {
  id               String @id @default(uuid())
  name             String
  enrollmentPrefix String
  serialStart      Int
  serialEnd        Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   BatchMember[]
  offerings CourseOffering[]

  @@unique([enrollmentPrefix, name])
}

/// An admin's allocation of one faculty member to teach one subject to one
/// section for a term. Assignments hang off this, so it is the single place
/// that answers "may this faculty publish work to these students?".
model CourseOffering {
  id           String  @id @default(uuid())
  facultyId    String
  batchId      String
  subjectId    String
  term         String
  assignedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  faculty    User    @relation("FacultyOfferings", fields: [facultyId], references: [id], onDelete: Cascade)
  batch      Batch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  subject    Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  assignedBy User?   @relation("OfferingsAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  assignments Assignment[]

  @@unique([batchId, subjectId, term])
  @@index([facultyId])
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
}

/// Coursework a faculty member hands to one section. Ownership is derived from
/// `offering`, never stored again — the offering is the only authority on which
/// faculty may touch this and which students may see it.
model Assignment {
  id          String @id @default(uuid())
  offeringId  String
  title       String
  description String?

  status AssignmentStatus @default(DRAFT)
  /// Set when published. A future value keeps the problems locked until then.
  publishAt DateTime?
  dueAt     DateTime?
  /// When false, submissions are refused once dueAt passes.
  allowLateSubmission Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offering CourseOffering      @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  problems AssignmentProblem[]

  @@index([offeringId, status])
}

model AssignmentProblem {
  id           String @id @default(uuid())
  assignmentId String
  problemId    String
  order        Int    @default(0)

  createdAt DateTime @default(now())

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  problem    Problem    @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, problemId])
  @@index([problemId])
}

enum NotificationType {
  COURSE_ASSIGNED_TO_FACULTY
  ASSIGNMENT_PUBLISHED
}

model Notification {
  id      String           @id @default(uuid())
  userId  String
  type    NotificationType
  title   String
  body    String?
  linkUrl String?
  readAt  DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model BatchMember {
  id      String @id @default(uuid())
  batchId String
  userId  String

  createdAt DateTime @default(now())

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([batchId, userId])
  @@index([userId])
}

model Problem {
  id          String      @id @default(uuid())
  title       String
  description String
  difficulty  Difficulty
  tags        String[]
  userId      String
  examples    Json
  constraints String
  hints       String?
  editorial   String?

  testCases         Json
  codeSnippets      Json
  referenceSolution Json

  unitId String?
  type   ProblemType @default(PRACTICE)
  executionMode ExecutionMode @default(JUDGE0_GRADE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit              Unit?               @relation(fields: [unitId], references: [id])
  submissions       Submission[]
  solvedBy          ProblemSolved[]
  problemsPlaylists ProblemInPlaylist[]
  codeSessions      CodeSession[]
  assignedIn        AssignmentProblem[]
}

model Submission {
  id            String  @id @default(uuid())
  userId        String
  problemId     String
  sourceCode    Json
  language      String
  stdin         String?
  stdout        String?
  stderr        String?
  complieOutput String?
  status        String
  memory        String?
  time          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  testCases TestCaseResult[]
}

model TestCaseResult {
  id            String  @id @default(uuid())
  submissionId  String
  testCase      Int
  passed        Boolean
  stdout        String?
  expected      String?
  stderr        String?
  complieOutput String?
  status        String?
  memory        String?
  time          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
}

model ProblemSolved {
  id        String   @id @default(uuid())
  userId    String
  problemId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
}

model Playlist {
  id          String  @id @default(uuid())
  name        String
  description String?
  userId      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  problems ProblemInPlaylist[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([name, userId]) // Unique playlist name per user
}

model ProblemInPlaylist {
  id         String @id @default(uuid())
  playListId String
  problemId  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  playlist Playlist @relation(fields: [playListId], references: [id], onDelete: Cascade)
  problem  Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([playListId, problemId]) // Prevent duplicate problems in the same playlist
}

enum ProctorEventType {
  PASTE_BLOCKED
  COPY_BLOCKED
  TAB_SWITCH
  WINDOW_BLUR
}

model CodeSession {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  problemId String
  problem   Problem   @relation(fields: [problemId], references: [id])
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  events    ProctorEvent[]

  @@index([userId, problemId])
}

model ProctorEvent {
  id        String           @id @default(uuid())
  sessionId String
  session   CodeSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type      ProctorEventType
  timestamp DateTime         @default(now())
  metadata  Json?
}
